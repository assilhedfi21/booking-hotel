{
  "info": {
    "name": "Hotel Booking Microservices",
    "description": "Complete REST + GraphQL collection for the Hotel Booking microservices project (SoA & Microservices, 2025/2026).\n\nBase URL is read from the environment variable `{{baseUrl}}` (default: http://localhost:4000).\n\nFlow to demo end-to-end:\n1. Health → confirm gateway up\n2. Hotels > List hotels\n3. Hotels > List rooms of hotel h-001\n4. Bookings > Create booking (saves the id in `bookingId`)\n5. Bookings > Get booking by id\n6. Notifications > List notifications by user (Kafka must be up)\n7. Bookings > Cancel booking\n8. GraphQL > * for cross-service queries",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "11111111-2222-3333-4444-555555555555"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "userEmail", "value": "alice@example.com" },
    { "key": "userName", "value": "Alice Tester" },
    { "key": "hotelId", "value": "h-001" },
    { "key": "roomId", "value": "r-001" },
    { "key": "bookingId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "Hotels (REST)",
      "item": [
        {
          "name": "List hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Search hotels (city + min_stars)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=Tunis&min_stars=4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "Tunis" },
                { "key": "min_stars", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Get hotel by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Create hotel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Royal Hammamet\",\n  \"city\": \"Hammamet\",\n  \"country\": \"Tunisia\",\n  \"description\": \"Luxury beachfront resort\",\n  \"stars\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            }
          }
        },
        {
          "name": "Update hotel",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laico Tunis (renovated)\",\n  \"city\": \"Tunis\",\n  \"country\": \"Tunisia\",\n  \"description\": \"Updated description\",\n  \"stars\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "Delete hotel",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}"]
            }
          }
        },
        {
          "name": "List rooms of a hotel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}", "rooms"]
            }
          }
        },
        {
          "name": "Add room to a hotel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"103\",\n  \"type\": \"DOUBLE\",\n  \"price_per_night\": 140,\n  \"capacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}", "rooms"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings (REST)",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) {",
                  "    pm.collectionVariables.set('bookingId', body.id);",
                  "    console.log('Saved bookingId =', body.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_email\": \"{{userEmail}}\",\n  \"user_name\": \"{{userName}}\",\n  \"hotel_id\": \"{{hotelId}}\",\n  \"room_id\": \"{{roomId}}\",\n  \"check_in\": \"2026-06-10\",\n  \"check_out\": \"2026-06-13\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "List all bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "List bookings by user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?user_email={{userEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [{ "key": "user_email", "value": "{{userEmail}}" }]
            }
          }
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications (REST)",
      "item": [
        {
          "name": "List all notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        },
        {
          "name": "List notifications by user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.notifications && body.notifications.length) {",
                  "    pm.collectionVariables.set('notificationId', body.notifications[0].id);",
                  "    console.log('Saved notificationId =', body.notifications[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?user_email={{userEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [{ "key": "user_email", "value": "{{userEmail}}" }]
            }
          }
        },
        {
          "name": "Mark notification as read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "{{notificationId}}", "read"]
            }
          }
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Query - all hotels with rooms",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ hotels { id name city stars rooms { id number type price_per_night available } } }\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Query - search hotels",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($city:String,$minStars:Int){ searchHotels(city:$city,minStars:$minStars){ id name stars rooms { number price_per_night } } }\",\n  \"variables\": { \"city\": \"Tunis\", \"minStars\": 4 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Query - bookings with hotel + room joined",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ bookings { id status total_price hotel { name city stars } room { number type price_per_night } } }\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Query - bookings by user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($email:String!){ bookingsByUser(userEmail:$email){ id status total_price check_in check_out hotel { name } } }\",\n  \"variables\": { \"email\": \"{{userEmail}}\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Query - notifications by user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($email:String!){ notificationsByUser(userEmail:$email){ id type title message read created_at } }\",\n  \"variables\": { \"email\": \"{{userEmail}}\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mutation - create hotel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($input:CreateHotelInput!){ createHotel(input:$input){ id name city stars } }\",\n  \"variables\": {\n    \"input\": {\n      \"name\": \"Royal Sousse\",\n      \"city\": \"Sousse\",\n      \"country\": \"Tunisia\",\n      \"description\": \"Created via GraphQL\",\n      \"stars\": 5\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mutation - add room",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($input:AddRoomInput!){ addRoom(input:$input){ id number type price_per_night } }\",\n  \"variables\": {\n    \"input\": {\n      \"hotelId\": \"{{hotelId}}\",\n      \"number\": \"104\",\n      \"type\": \"SUITE\",\n      \"pricePerNight\": 220,\n      \"capacity\": 3\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mutation - create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.data && body.data.createBooking) {",
                  "    pm.collectionVariables.set('bookingId', body.data.createBooking.id);",
                  "    console.log('Saved bookingId =', body.data.createBooking.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($input:CreateBookingInput!){ createBooking(input:$input){ id status nights total_price } }\",\n  \"variables\": {\n    \"input\": {\n      \"userEmail\": \"{{userEmail}}\",\n      \"userName\": \"{{userName}}\",\n      \"hotelId\": \"{{hotelId}}\",\n      \"roomId\": \"{{roomId}}\",\n      \"checkIn\": \"2026-07-01\",\n      \"checkOut\": \"2026-07-04\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mutation - cancel booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id:ID!){ cancelBooking(id:$id){ id status } }\",\n  \"variables\": { \"id\": \"{{bookingId}}\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mutation - mark notification as read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id:ID!){ markNotificationAsRead(id:$id){ id read title } }\",\n  \"variables\": { \"id\": \"{{notificationId}}\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            }
          }
        }
      ]
    }
  ]
}
